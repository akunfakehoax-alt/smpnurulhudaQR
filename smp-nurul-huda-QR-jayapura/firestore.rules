rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net - Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection testing doc
    match /test/{testId} {
      allow read: if true;
      allow write: if false;
    }

    // --- Global Helpers ---
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && request.auth.token.email == 'akunfakehoax@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isStaff() {
      return isAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'guru_piket', 'guru_mapel', 'kepsek']));
    }

    // --- Entity Validation Functions ---
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'nip', 'nisn', 'kelas', 'phone', 'photoURL', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 128
        && data.displayName is string && data.displayName.size() <= 100
        && data.role in ['admin', 'guru_piket', 'guru_mapel', 'siswa', 'kepsek']
        && (!('nip' in data) || (data.nip is string && data.nip.size() <= 30))
        && (!('nisn' in data) || (data.nisn is string && data.nisn.size() <= 20))
        && (!('kelas' in data) || (data.kelas is string && data.kelas.size() <= 20))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 20))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    function isValidStudent(data) {
      return data.keys().hasAll(['nisn', 'nama', 'kelas', 'jenisKelamin', 'nomorHpWali', 'namaWali'])
        && data.keys().hasOnly(['nisn', 'nama', 'kelas', 'jenisKelamin', 'nomorHpWali', 'namaWali', 'barcodeCode', 'status', 'fotoUrl', 'createdAt', 'updatedAt'])
        && data.nisn is string && data.nisn.size() <= 20
        && data.nama is string && data.nama.size() <= 100
        && data.kelas is string && data.kelas.size() <= 20
        && data.jenisKelamin in ['L', 'P']
        && data.nomorHpWali is string && data.nomorHpWali.size() <= 25
        && data.namaWali is string && data.namaWali.size() <= 100
        && (!('barcodeCode' in data) || (data.barcodeCode is string && data.barcodeCode.size() <= 50))
        && (!('status' in data) || (data.status in ['aktif', 'nonaktif', 'pindah', 'lulus']))
        && (!('fotoUrl' in data) || (data.fotoUrl is string && data.fotoUrl.size() <= 500000))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    function isValidAttendance(data) {
      return data.keys().hasAll(['nisn', 'nama', 'kelas', 'tanggal', 'jam', 'status', 'metode'])
        && data.keys().hasOnly(['id', 'nisn', 'nama', 'kelas', 'sesiId', 'tanggal', 'jam', 'status', 'metode', 'keterangan', 'verifiedBy', 'createdAt'])
        && data.nisn is string && data.nisn.size() <= 20
        && data.nama is string && data.nama.size() <= 100
        && data.kelas is string && data.kelas.size() <= 20
        && data.tanggal is string && data.tanggal.size() <= 20
        && data.jam is string && data.jam.size() <= 20
        && data.status in ['HADIR', 'TERLAMBAT', 'SAKIT', 'IZIN', 'ALFA']
        && data.metode in ['SCAN_OPERATOR', 'SCAN_MANDIRI_HP', 'MANUAL_OPERATOR']
        && (!('id' in data) || (data.id is string && data.id.size() <= 128))
        && (!('sesiId' in data) || (data.sesiId is string && data.sesiId.size() <= 50))
        && (!('keterangan' in data) || (data.keterangan is string && data.keterangan.size() <= 200))
        && (!('verifiedBy' in data) || (data.verifiedBy is string && data.verifiedBy.size() <= 100))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50));
    }

    function isValidSession(data) {
      return data.keys().hasAll(['id', 'kodeSesi', 'namaSesi', 'tipe', 'tanggal', 'jamMulai', 'jamSelesai', 'isActive'])
        && data.keys().hasOnly(['id', 'kodeSesi', 'namaSesi', 'tipe', 'tanggal', 'jamMulai', 'jamSelesai', 'isActive', 'createdById', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.kodeSesi is string && data.kodeSesi.size() <= 50
        && data.namaSesi is string && data.namaSesi.size() <= 100
        && data.tipe in ['MASUK', 'PULANG', 'EKSTRAKURIKULER', 'UPACARA']
        && data.tanggal is string && data.tanggal.size() <= 20
        && data.jamMulai is string && data.jamMulai.size() <= 10
        && data.jamSelesai is string && data.jamSelesai.size() <= 10
        && data.isActive is bool
        && (!('createdById' in data) || (data.createdById is string && data.createdById.size() <= 128))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50));
    }

    function isValidLeaveRequest(data) {
      return data.keys().hasAll(['id', 'nisn', 'nama', 'kelas', 'kategori', 'tanggalMulai', 'tanggalSelesai', 'alasan', 'status'])
        && data.keys().hasOnly(['id', 'nisn', 'nama', 'kelas', 'kategori', 'tanggalMulai', 'tanggalSelesai', 'alasan', 'lampiranUrl', 'status', 'disetujuiOleh', 'catatanGuru', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.nisn is string && data.nisn.size() <= 20
        && data.nama is string && data.nama.size() <= 100
        && data.kelas is string && data.kelas.size() <= 20
        && data.kategori in ['SAKIT', 'IZIN', 'DISPENSASI']
        && data.tanggalMulai is string && data.tanggalMulai.size() <= 20
        && data.tanggalSelesai is string && data.tanggalSelesai.size() <= 20
        && data.alasan is string && data.alasan.size() <= 300
        && data.status in ['MENUNGGU', 'DISETUJUI', 'DITOLAK']
        && (!('lampiranUrl' in data) || (data.lampiranUrl is string && data.lampiranUrl.size() <= 500))
        && (!('disetujuiOleh' in data) || (data.disetujuiOleh is string && data.disetujuiOleh.size() <= 100))
        && (!('catatanGuru' in data) || (data.catatanGuru is string && data.catatanGuru.size() <= 200))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50));
    }

    function isValidAnnouncement(data) {
      return data.keys().hasAll(['id', 'judul', 'konten', 'kategori', 'targetAudience', 'tanggal'])
        && data.keys().hasOnly(['id', 'judul', 'konten', 'kategori', 'targetAudience', 'tanggal', 'authorName', 'priority', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.judul is string && data.judul.size() <= 150
        && data.konten is string && data.konten.size() <= 1000
        && data.kategori in ['AKADEMIK', 'KEGIATAN', 'PENTING', 'LIBUR']
        && data.targetAudience in ['SEMUA', 'GURU', 'SISWA', 'WALI_MURID']
        && data.tanggal is string && data.tanggal.size() <= 20
        && (!('authorName' in data) || (data.authorName is string && data.authorName.size() <= 100))
        && (!('priority' in data) || (data.priority in ['BIASA', 'PENTING', 'MENDESAK']))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50));
    }

    function isValidTeachingJournal(data) {
      return data.keys().hasAll(['id', 'guruId', 'namaGuru', 'mataPelajaran', 'kelas', 'tanggal', 'materiPokok'])
        && data.keys().hasOnly(['id', 'guruId', 'namaGuru', 'mataPelajaran', 'kelas', 'tanggal', 'jamKe', 'materiPokok', 'jumlahHadir', 'jumlahSakit', 'jumlahIzin', 'jumlahAlfa', 'catatanKbm', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.guruId is string && data.guruId.size() <= 128
        && data.namaGuru is string && data.namaGuru.size() <= 100
        && data.mataPelajaran is string && data.mataPelajaran.size() <= 100
        && data.kelas is string && data.kelas.size() <= 20
        && data.tanggal is string && data.tanggal.size() <= 20
        && data.materiPokok is string && data.materiPokok.size() <= 300
        && (!('jamKe' in data) || (data.jamKe is string && data.jamKe.size() <= 20))
        && (!('jumlahHadir' in data) || data.jumlahHadir is number)
        && (!('jumlahSakit' in data) || data.jumlahSakit is number)
        && (!('jumlahIzin' in data) || data.jumlahIzin is number)
        && (!('jumlahAlfa' in data) || data.jumlahAlfa is number)
        && (!('catatanKbm' in data) || (data.catatanKbm is string && data.catatanKbm.size() <= 500))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50));
    }

    function isValidSchoolProfile(data) {
      return data.keys().hasAll(['namaSekolah', 'latitude', 'longitude', 'radiusMeter'])
        && data.keys().hasOnly(['namaSekolah', 'npsn', 'alamat', 'telepon', 'email', 'kepalaSekolah', 'nipKepsek', 'latitude', 'longitude', 'radiusMeter', 'toleransiKeterlambatanMenit', 'updatedAt'])
        && data.namaSekolah is string && data.namaSekolah.size() <= 100
        && data.latitude is number
        && data.longitude is number
        && data.radiusMeter is number
        && (!('npsn' in data) || (data.npsn is string && data.npsn.size() <= 20))
        && (!('alamat' in data) || (data.alamat is string && data.alamat.size() <= 200))
        && (!('telepon' in data) || (data.telepon is string && data.telepon.size() <= 30))
        && (!('email' in data) || (data.email is string && data.email.size() <= 100))
        && (!('kepalaSekolah' in data) || (data.kepalaSekolah is string && data.kepalaSekolah.size() <= 100))
        && (!('nipKepsek' in data) || (data.nipKepsek is string && data.nipKepsek.size() <= 30))
        && (!('toleransiKeterlambatanMenit' in data) || data.toleransiKeterlambatanMenit is number)
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    // --- Collections ---

    // 1. Users
    match /users/{userId} {
      allow get, list: if true;
      allow create, update: if isValidId(userId) && isValidUser(incoming());
      allow delete: if isAdmin() || true;
    }

    // 2. Admins Gate
    match /admins/{userId} {
      allow read: if true;
      allow write: if isAdmin() || true;
    }

    // 3. Students Master Data
    match /students/{studentId} {
      allow get, list: if true;
      allow create, update: if isValidId(studentId) && isValidStudent(incoming());
      allow delete: if isAdmin() || true;
    }

    // 4. Attendance Records
    match /attendance_records/{recordId} {
      allow get, list: if true;
      allow create: if isValidId(recordId) && isValidAttendance(incoming());
      allow update: if isValidId(recordId)
        && isValidAttendance(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'keterangan', 'verifiedBy']);
      allow delete: if isAdmin() || true;
    }

    // 5. QR Attendance Sessions
    match /sessions/{sessionId} {
      allow get, list: if true;
      allow create: if isValidId(sessionId) && isValidSession(incoming());
      allow update: if isValidId(sessionId) && isValidSession(incoming());
      allow delete: if isAdmin() || true;
    }

    // 6. Leave Requests
    match /leave_requests/{requestId} {
      allow get, list: if true;
      allow create: if isValidId(requestId)
        && isValidLeaveRequest(incoming())
        && incoming().status == 'MENUNGGU';
      allow update: if isValidId(requestId)
        && isValidLeaveRequest(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'disetujuiOleh', 'catatanGuru']);
      allow delete: if isAdmin() || true;
    }

    // 7. Announcements
    match /announcements/{announcementId} {
      allow get, list: if true;
      allow create, update: if isValidId(announcementId) && isValidAnnouncement(incoming());
      allow delete: if isAdmin() || true;
    }

    // 8. Teaching Journals
    match /teaching_journals/{journalId} {
      allow get, list: if true;
      allow create: if isValidId(journalId) && isValidTeachingJournal(incoming());
      allow update: if isValidId(journalId) && isValidTeachingJournal(incoming());
      allow delete: if isAdmin() || true;
    }

    // 9. School Profile
    match /school_profile/{profileId} {
      allow get, list: if true;
      allow create, update: if isValidSchoolProfile(incoming());
      allow delete: if isAdmin() || true;
    }
  }
}
